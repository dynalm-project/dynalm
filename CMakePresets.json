{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-asan",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_TSAN": "ON",
        "ENABLE_GGML_CPU": "OFF"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "base",
      "displayName": "Linux, clang, release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-release",
      "inherits": "base",
      "displayName": "macOS (Apple Silicon or Intel), release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-metal",
      "inherits": "base",
      "displayName": "macOS Apple Silicon, release, Metal GPU backend (prototype)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_METAL": "ON"
      }
    },
    {
      "name": "macos-vulkan",
      "inherits": "base",
      "displayName": "macOS, release, Vulkan GPU backend through MoltenVK (development and testing)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "linux-vulkan",
      "inherits": "base",
      "displayName": "Linux, release, Vulkan GPU backend (AMD / Intel / NVIDIA)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "linux-cuda",
      "inherits": "base",
      "displayName": "Linux, release, CUDA GPU backend (NVIDIA)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "msvc-vulkan",
      "inherits": "msvc-base",
      "displayName": "Windows, release, Vulkan GPU backend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "msvc-cuda",
      "inherits": "msvc-base",
      "displayName": "Windows x64, release, CUDA GPU backend (NVIDIA)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "base",
      "displayName": "Windows on ARM (Snapdragon), release, clang-cl (run from an ARM64 Developer prompt)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "core-only",
      "inherits": "base",
      "displayName": "DynaCore alone (boundary check)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DYNALM_CORE_ONLY": "ON",
        "ENABLE_SERVER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-asan",
      "configurePreset": "msvc-asan"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-metal",
      "configurePreset": "macos-metal"
    },
    {
      "name": "macos-vulkan",
      "configurePreset": "macos-vulkan"
    },
    {
      "name": "linux-vulkan",
      "configurePreset": "linux-vulkan"
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda"
    },
    {
      "name": "msvc-vulkan",
      "configurePreset": "msvc-vulkan"
    },
    {
      "name": "msvc-cuda",
      "configurePreset": "msvc-cuda"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only"
    }
  ]
}
